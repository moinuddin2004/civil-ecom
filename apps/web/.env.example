# Aricon web configuration. Copy to `.env` for local development: `cp .env.example .env`.
# Never commit a real `.env`.

# Server side only: where server components reach the API (never exposed to the browser).
# Production: http://127.0.0.1:4000 (same VPS).
INTERNAL_API_URL=http://127.0.0.1:4000

# Must match REVALIDATE_SECRET in apps/api/.env. At least 32 characters.
# Values starting with "dev-only-" are refused in production.
REVALIDATE_SECRET=dev-only-revalidate-secret-0123456789abcdef

# Public values are inlined into the browser bundle at build time: set them before `pnpm build`.
# Canonical site address (SEO, Open Graph). Production: https://shop.aricon.com.pk
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL of product and banner images. Production: https://images.aricon.com.pk
NEXT_PUBLIC_IMAGE_BASE_URL=http://localhost:3000/api/dev-files
