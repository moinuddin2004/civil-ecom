# Aricon API — values that are the SAME in development and production.
#
# How the files fit together (NODE_ENV picks the profile; `pnpm dev` is development, the server
# runs production):
#   .env              ← this file: common values, always loaded
#   .env.development  ← development only; its values override this file
#   .env.production   ← production only; its values override this file
#   .env.example      ← a template listing every variable and what it is for (not loaded)
# A real environment variable set on the machine beats every file.
# Every value is checked at start-up (src/config/env.schema.ts); the API prints what is missing.

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Runtime
# ────────────────────────────────────────────────────────────────────────────────────────────────
# Interface to bind. Keep 127.0.0.1: only Nginx (production) or the Next.js dev server talks to the API.
HOST=127.0.0.1
PORT=4000

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Auth lifetimes
# ────────────────────────────────────────────────────────────────────────────────────────────────
# Access token lifetime in seconds (60–3600). Short: access tokens can't be revoked.
JWT_ACCESS_TTL_SECONDS=900
# Refresh tokens (stored hashed, revocable): rolling 30 days for customers, 12 hours for staff.
CUSTOMER_REFRESH_TTL_DAYS=30
ADMIN_REFRESH_TTL_HOURS=12

# ────────────────────────────────────────────────────────────────────────────────────────────────
# URLs
# ────────────────────────────────────────────────────────────────────────────────────────────────
# Company-website origins allowed to call POST /api/public/rfp (comma-separated).
RFP_CORS_ORIGINS=https://aricon.com.pk,https://www.aricon.com.pk
# Next.js server (runs next to the API), for on-demand revalidation (POST /_internal/revalidate).
WEB_INTERNAL_URL=http://127.0.0.1:3000

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Storage names
# ────────────────────────────────────────────────────────────────────────────────────────────────
# local driver only: where files are kept (public/ and private/ inside it), relative to apps/api.
STORAGE_LOCAL_DIR=.uploads
# Cloudflare R2 bucket names (the keys themselves go in .env.production).
R2_PUBLIC_BUCKET=aricon-public
R2_PRIVATE_BUCKET=aricon-private

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Email
# ────────────────────────────────────────────────────────────────────────────────────────────────
MAIL_FROM="Aricon Shop <no-reply@aricon.com.pk>"
