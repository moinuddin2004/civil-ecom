# Aricon API configuration — every variable, with what it is for.
# Validated at startup (src/config/env.schema.ts): the API exits with a list of problems if
# something is missing or wrong.
#
# Profiles (NODE_ENV = development | test | production) load these files, first match wins:
#   .env.{profile}.local  →  .env.{profile}  →  .env.local (not in test)  →  .env
# .env.development and .env.test are committed with safe example values, so `pnpm dev` works with
# no setup. Put personal overrides in .env.development.local (git-ignored).
# Production reads no file from the repo: set real values in the server's environment (SPEC §18).

# ── Runtime ──────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Interface to bind. Keep 127.0.0.1 in production: only Nginx talks to the API.
HOST=127.0.0.1
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Swagger UI at /api/docs (never served in production).
API_DOCS_ENABLED=true
# Per-IP rate limits on login, signup, forgot password… (SPEC §7.1). Must stay on in production.
RATE_LIMIT_ENABLED=true

# ── Database ─────────────────────────────────────────────────────────────────────────────────────
# Must be a replica set (transactions). Local: `docker compose -f infra/docker-compose.yml up -d`.
MONGODB_URI=mongodb://127.0.0.1:27017/aricon?replicaSet=rs0

# ── Auth (JWT) ───────────────────────────────────────────────────────────────────────────────────
# Separate signing keys for customer and staff access tokens, so one can never pass the other's
# guard. At least 32 characters each, and different. Production: `openssl rand -base64 48`.
# Values starting with "dev-only-" are refused when NODE_ENV=production.
JWT_CUSTOMER_SECRET=dev-only-jwt-customer-secret-0123456789abcdef
JWT_ADMIN_SECRET=dev-only-jwt-admin-secret-0123456789abcdefghij
# Access token lifetime in seconds (60–3600). Short: access tokens can't be revoked.
JWT_ACCESS_TTL_SECONDS=900
# Refresh tokens (stored hashed, revocable): rolling 30 days for customers, 12 hours for staff.
CUSTOMER_REFRESH_TTL_DAYS=30
ADMIN_REFRESH_TTL_HOURS=12

# ── URLs ─────────────────────────────────────────────────────────────────────────────────────────
# Public address of the shop: emails, and the Origin check on state-changing requests. https in production.
APP_URL=http://localhost:3000
# Company-website origins allowed to call POST /api/public/rfp (comma-separated).
RFP_CORS_ORIGINS=https://aricon.com.pk,https://www.aricon.com.pk
# Next.js server, for on-demand revalidation (POST /_internal/revalidate).
WEB_INTERNAL_URL=http://127.0.0.1:3000
# Shared with the web app (apps/web/.env). At least 32 characters.
REVALIDATE_SECRET=dev-only-revalidate-secret-0123456789abcdef

# ── File storage ─────────────────────────────────────────────────────────────────────────────────
# local = files under apps/api/.uploads (development only); r2 = Cloudflare R2 (required in production).
STORAGE_DRIVER=local
# local driver only: where files are kept (public/ and private/ inside it). Served in development at
# /api/dev-files; private files only through short-lived signed links.
STORAGE_LOCAL_DIR=.uploads
# Required when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=aricon-public
R2_PRIVATE_BUCKET=aricon-private
# Base URL of public images. Production: https://images.aricon.com.pk
PUBLIC_IMAGE_BASE_URL=http://localhost:3000/api/dev-files

# ── Email ────────────────────────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: emails are written to the log instead of being sent.
# Required in production.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aricon Shop <no-reply@aricon.com.pk>"

# ── Seed only (pnpm --filter api seed:admin) ─────────────────────────────────────────────────────
# First ADMIN account. Remove from the server after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
