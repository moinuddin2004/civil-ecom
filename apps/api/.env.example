# Aricon API configuration — every variable, with what it is for. A TEMPLATE: the API does not read it.
# Validated at startup (src/config/env.schema.ts): the API exits with a list of problems if
# something is missing or wrong.
#
# Files (NODE_ENV = development | test | production picks the profile; `pnpm dev` is development):
#   .env              common values, same in development and production — always loaded
#   .env.development  development only; overrides .env
#   .env.production   production only; overrides .env
#   .env.test         tests only (loaded instead of .env, so tests behave the same on every machine)
# A real environment variable set on the machine beats every file.
# New machine? Create .env, .env.development and .env.production with the variables below (the
# "where" note on each variable says which file it belongs in).

# ── Runtime ──────────────────────────────────────────────────────────────────────────────────────
# [.env] Interface to bind. Keep 127.0.0.1: only Nginx (production) or the Next.js dev server talks to the API.
HOST=127.0.0.1
PORT=4000
# [.env.development / .env.production] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# [.env.development / .env.production] Swagger UI at /api/docs (never served in production).
API_DOCS_ENABLED=true
# [.env.development / .env.production] Per-IP rate limits on login, signup, forgot password… (SPEC §7.1). Must stay on in production.
RATE_LIMIT_ENABLED=true

# ── Database ─────────────────────────────────────────────────────────────────────────────────────
# [.env.development / .env.production] Must be a replica set (transactions).
# Local: `docker compose -f infra/docker-compose.yml up -d`.
MONGODB_URI=mongodb://127.0.0.1:27017/aricon?replicaSet=rs0

# ── Auth (JWT) ───────────────────────────────────────────────────────────────────────────────────
# [.env.development / .env.production] Separate signing keys for customer and staff access tokens, so
# one can never pass the other's guard. At least 32 characters each, and different.
# Production: `openssl rand -base64 48`. Values starting with "dev-only-" are refused in production.
JWT_CUSTOMER_SECRET=dev-only-jwt-customer-secret-0123456789abcdef
JWT_ADMIN_SECRET=dev-only-jwt-admin-secret-0123456789abcdefghij
# [.env] Access token lifetime in seconds (60–3600). Short: access tokens can't be revoked.
JWT_ACCESS_TTL_SECONDS=900
# [.env] Refresh tokens (stored hashed, revocable): rolling 30 days for customers, 12 hours for staff.
CUSTOMER_REFRESH_TTL_DAYS=30
ADMIN_REFRESH_TTL_HOURS=12

# ── URLs ─────────────────────────────────────────────────────────────────────────────────────────
# [.env.development / .env.production] Public address of the shop: emails, and the Origin check on
# state-changing requests. https in production.
APP_URL=http://localhost:3000
# [.env] Company-website origins allowed to call POST /api/public/rfp (comma-separated).
RFP_CORS_ORIGINS=https://aricon.com.pk,https://www.aricon.com.pk
# [.env] Next.js server, for on-demand revalidation (POST /_internal/revalidate).
WEB_INTERNAL_URL=http://127.0.0.1:3000
# [.env.development / .env.production] Shared with the web app (apps/web). At least 32 characters.
REVALIDATE_SECRET=dev-only-revalidate-secret-0123456789abcdef

# ── File storage ─────────────────────────────────────────────────────────────────────────────────
# [.env.development / .env.production] local = files under apps/api/.uploads (development only);
# r2 = Cloudflare R2 (required in production).
STORAGE_DRIVER=local
# [.env] local driver only: where files are kept (public/ and private/ inside it). Served in
# development at /api/dev-files; private files only through short-lived signed links.
STORAGE_LOCAL_DIR=.uploads
# [.env.production] Required when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# [.env] Bucket names.
R2_PUBLIC_BUCKET=aricon-public
R2_PRIVATE_BUCKET=aricon-private
# [.env.development / .env.production] Base URL of public images. Production: https://images.aricon.com.pk
PUBLIC_IMAGE_BASE_URL=http://localhost:3000/api/dev-files

# ── Email ────────────────────────────────────────────────────────────────────────────────────────
# [.env.development / .env.production] Leave SMTP_HOST empty in development: emails are written to
# the log instead of being sent. Required in production.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# [.env]
MAIL_FROM="Aricon Shop <no-reply@aricon.com.pk>"

# ── Seed only (pnpm --filter api seed:admin) ─────────────────────────────────────────────────────
# [.env.development / .env.production] First ADMIN account. Remove from the server after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
