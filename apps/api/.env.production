# Aricon API — PRODUCTION only (the server). Overrides .env.
# Fill in every REPLACE-ME / empty value. The API refuses to start in production while a secret
# still starts with "dev-only-", or while R2, SMTP or https settings are missing.

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Runtime
# ────────────────────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Swagger UI is never served in production, whatever this says.
API_DOCS_ENABLED=false
# Must stay on in production.
RATE_LIMIT_ENABLED=true

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────────────────────────────────
# Your production MongoDB (a replica set: transactions need one).
MONGODB_URI=mongodb+srv://REPLACE-USER:REPLACE-PASSWORD@REPLACE-HOST/aricon?retryWrites=true&w=majority

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Auth secrets: generate each with `openssl rand -base64 48` (different from each other and from development)
# ────────────────────────────────────────────────────────────────────────────────────────────────
JWT_CUSTOMER_SECRET=dev-only-REPLACE-ME-run-openssl-rand-base64-48
JWT_ADMIN_SECRET=dev-only-REPLACE-ME-run-openssl-rand-base64-48-admin

# ────────────────────────────────────────────────────────────────────────────────────────────────
# URLs
# ────────────────────────────────────────────────────────────────────────────────────────────────
APP_URL=https://shop.aricon.com.pk
# Shared with the web app's production environment (apps/web). Generate with `openssl rand -base64 48`.
REVALIDATE_SECRET=dev-only-REPLACE-ME-run-openssl-rand-base64-48-revalidate
# Verification links default to ${APP_URL}/verify-email; optional override below.
EMAIL_VERIFICATION_URL=
EMAIL_VERIFICATION_TOKEN_EXPIRES_MINUTES=60

# Google sign-in for customers (required in production): OAuth 2.0 Web application client.
# Authorised redirect URI: https://shop.aricon.com.pk/api/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE-ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dev-only-REPLACE-ME-run-openssl-rand-base64-48
GOOGLE_CALLBACK_URL=https://shop.aricon.com.pk/api/auth/google/callback

# ────────────────────────────────────────────────────────────────────────────────────────────────
# File storage: Cloudflare R2 (required in production)
# ────────────────────────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PUBLIC_IMAGE_BASE_URL=https://images.aricon.com.pk

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Email (required in production)
# ────────────────────────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Seed only (pnpm --filter api seed:admin): the first ADMIN account. Remove after seeding.
# ────────────────────────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
