# Test profile (committed; no real secrets). The e2e tests start an in-memory MongoDB replica set
# and set MONGODB_URI themselves; real environment variables always beat this file.
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=silent
API_DOCS_ENABLED=false
# Many tests log in from one IP; the rate-limit suite turns this back on for itself.
RATE_LIMIT_ENABLED=false

MONGODB_URI=mongodb://127.0.0.1:27017/aricon-test?replicaSet=rs0

JWT_CUSTOMER_SECRET=dev-only-test-customer-secret-0123456789abcdef
JWT_ADMIN_SECRET=dev-only-test-admin-secret-0123456789abcdefghij

APP_URL=http://localhost:3000
WEB_INTERNAL_URL=http://127.0.0.1:3000
REVALIDATE_SECRET=dev-only-test-revalidate-secret-0123456789

# Google sign-in (dummy values: the suite never talks to Google; start only checks they exist).
GOOGLE_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dev-only-test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

STORAGE_DRIVER=local
PUBLIC_IMAGE_BASE_URL=http://localhost:3000/api/dev-files
