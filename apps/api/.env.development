# Aricon API — DEVELOPMENT only (`pnpm dev`). Overrides .env.
# Real values for your own machine live here: your database address, dev secrets, local storage.

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Runtime
# ────────────────────────────────────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Swagger UI at /api/docs.
API_DOCS_ENABLED=true
# Per-IP rate limits (SPEC §7.1). Set to false if they get in the way while testing by hand.
RATE_LIMIT_ENABLED=true

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────────────────────────────────
# Must be a replica set (transactions). Local: `docker compose -f infra/docker-compose.yml up -d`
# gives mongodb://127.0.0.1:27017/aricon?replicaSet=rs0 — or use your Atlas connection string.
MONGODB_URI=mongodb+srv://syedmoinuddin:moin1234@cluster0.iiql1rp.mongodb.net/aricon?retryWrites=true&w=majority

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Auth secrets (at least 32 characters each, and different)
# ────────────────────────────────────────────────────────────────────────────────────────────────
JWT_CUSTOMER_SECRET=dev-only-jwt-customer-secret-0123456789abcdef
JWT_ADMIN_SECRET=dev-only-jwt-admin-secret-0123456789abcdefghij

# ────────────────────────────────────────────────────────────────────────────────────────────────
# URLs
# ────────────────────────────────────────────────────────────────────────────────────────────────
# Public address of the shop (emails, and the Origin check on state-changing requests).
APP_URL=http://localhost:3000
# Shared with the web app (apps/web/.env). At least 32 characters.
REVALIDATE_SECRET=dev-only-revalidate-secret-0123456789abcdef

# ────────────────────────────────────────────────────────────────────────────────────────────────
# File storage
# ────────────────────────────────────────────────────────────────────────────────────────────────
# local = files under apps/api/.uploads, served at /api/dev-files.
STORAGE_DRIVER=local
PUBLIC_IMAGE_BASE_URL=http://localhost:3000/api/dev-files
# Only if you test with STORAGE_DRIVER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Email
# ────────────────────────────────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty: emails are written to the log instead of being sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ────────────────────────────────────────────────────────────────────────────────────────────────
# Seed only (pnpm --filter api seed:admin): the first ADMIN account.
# ────────────────────────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=moin@gmail.com
ADMIN_PASSWORD=moin1234
